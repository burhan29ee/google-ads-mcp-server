# Google Ads API credentials for the MCP server.
#
# You need a DEVELOPER TOKEN (Basic access to touch real accounts) plus either
# OAuth2 credentials (below) or a service account with domain-wide delegation.
# LOGIN_CUSTOMER_ID is your manager (MCC) account id, digits only, no dashes.
#
# The google-ads library reads these standard variables automatically.

GOOGLE_ADS_DEVELOPER_TOKEN=your-developer-token
GOOGLE_ADS_LOGIN_CUSTOMER_ID=1234567890

# --- OAuth2 (most common) ---
GOOGLE_ADS_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GOOGLE_ADS_CLIENT_SECRET=your-oauth-client-secret
GOOGLE_ADS_REFRESH_TOKEN=your-oauth-refresh-token

# --- Or: a google-ads.yaml file instead of the variables above ---
# GOOGLE_ADS_CONFIGURATION_FILE_PATH=/absolute/path/to/google-ads.yaml
